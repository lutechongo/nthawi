{
  "manifest_version": 3,
  "name": "Nthawi",
  "short_name": "Nthawi",
  "version": "1.2.0",
  "description": "Time tracking without the stress. Nthawi quietly logs your focused time in Figma, Meet, Docs and more, so you never have to.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nthawi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "unlimitedStorage",
    "alarms",
    "notifications",
    "favicon"
  ],
  "host_permissions": [
    "https://api.clickup.com/*"
  ],
  "key": ""
}
